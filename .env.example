# Copy this file to .env for Docker Compose or configure these as cloud Secrets.
# NEVER commit a real .env file or API key to Git.

# --- Model & Runtime Mode ---
# auto = live DeepSeek when DEEPSEEK_API_KEY is non-empty, else zero-API demo mode
APP_MODE=auto
DEEPSEEK_API_KEY=

# --- Network ---
HOST=0.0.0.0
PORT=7860
HOST_PORT=8000

# --- RAG & Safeguards ---
# hybrid = Qdrant Dense + Okapi BM25 RRF fusion; dense = vector only
RETRIEVAL_MODE=hybrid
RATE_LIMIT_RPM=30
DAILY_TOKEN_BUDGET=500000
# Set true to disable 1-click demo account switching and require --init-auth passwords
STRICT_AUTH=false
# Set true to automatically build runtime/knowledge_demo on startup if missing
AUTO_BUILD_INDEX=false

# --- Optional Langfuse Tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
